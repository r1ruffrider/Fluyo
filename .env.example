# Application runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Supabase Auth. Replace placeholders with one project's public configuration.
# Allow <NEXT_PUBLIC_WEB_URL>/auth/callback in that project's Auth redirect URLs.
SUPABASE_URL=https://example.supabase.co
SUPABASE_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Local PostgreSQL only. Replace every value in deployed environments.
POSTGRES_USER=fluyo
POSTGRES_PASSWORD=fluyo_local
POSTGRES_DB=fluyo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fluyo:fluyo_local@localhost:5432/fluyo?schema=public
