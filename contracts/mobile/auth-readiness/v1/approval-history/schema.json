{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluyo.invalid/contracts/mobile/auth-readiness/v1/approval-history/schema.json",
  "title": "Fluyo native-auth approval-history record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ledgerId",
    "sequence",
    "previousRecordDigest",
    "recordedAtUtc",
    "eventType",
    "actor",
    "authority",
    "subject",
    "payload",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "ledgerId": {
      "const": "fluyo-native-auth-approval-history-v1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previousRecordDigest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "recordedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "eventType": {
      "enum": [
        "GOVERNANCE_SELECTION",
        "DELEGATION_GRANT",
        "DELEGATION_REVOCATION",
        "MIGRATION_SNAPSHOT",
        "REVIEW_ATTESTATION",
        "DECISION_APPROVAL",
        "DECISION_SUPERSESSION",
        "PHASE_APPROVAL",
        "TOOLING_CHANGE_AUTHORIZATION"
      ]
    },
    "actor": {
      "enum": ["Marlon", "Adriana"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "grantedBy", "referenceRecordDigests"],
      "properties": {
        "kind": {
          "enum": [
            "direct_material_owner_authority",
            "delegated_credential_free_repository_authority",
            "administrative_migration_recording"
          ]
        },
        "grantedBy": {
          "const": "Marlon"
        },
        "referenceRecordDigests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/governancePayload"
        },
        {
          "$ref": "#/$defs/delegationGrantPayload"
        },
        {
          "$ref": "#/$defs/delegationRevocationPayload"
        },
        {
          "$ref": "#/$defs/migrationPayload"
        },
        {
          "$ref": "#/$defs/reviewPayload"
        },
        {
          "$ref": "#/$defs/decisionApprovalPayload"
        },
        {
          "$ref": "#/$defs/decisionSupersessionPayload"
        },
        {
          "$ref": "#/$defs/phaseApprovalPayload"
        },
        {
          "$ref": "#/$defs/toolingPayload"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "recordedBy",
        "recordingMethod",
        "integrityScope",
        "nonRepudiationLimitation"
      ],
      "properties": {
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "recordedBy": {
          "const": "Adriana"
        },
        "recordingMethod": {
          "const": "repository_governance_record"
        },
        "integrityScope": {
          "const": "canonical_record_bytes_and_declared_subject_bytes"
        },
        "nonRepudiationLimitation": {
          "const": "repository_records_prove_integrity_and_declared_authority_after_recording_not_cryptographic_human_nonrepudiation"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bundleSha256"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "bundleSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "governancePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "effectiveFor",
        "retiredMechanism",
        "bootstrapCommit",
        "decisionPolicySha256",
        "evidenceIndexSha256"
      ],
      "properties": {
        "selection": {
          "const": "APPEND_ONLY_CONTENT_ADDRESSED_SQUASH_COMPATIBLE"
        },
        "effectiveFor": {
          "type": "string",
          "minLength": 1
        },
        "retiredMechanism": {
          "type": "string",
          "minLength": 1
        },
        "bootstrapCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "decisionPolicySha256": {
          "$ref": "#/$defs/digest"
        },
        "evidenceIndexSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "delegationGrantPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegate",
        "scope",
        "requiredPhaseGates",
        "sameSubjectBundleRequired",
        "deniedActions",
        "materialDecisionIds",
        "usableOnlyAfterLedgerMerge"
      ],
      "properties": {
        "delegate": {
          "const": "Adriana"
        },
        "scope": {
          "const": "credential_free_repository_only_nonproduction_phase_after_required_gates"
        },
        "requiredPhaseGates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sameSubjectBundleRequired": {
          "const": true
        },
        "deniedActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "materialDecisionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "usableOnlyAfterLedgerMerge": {
          "const": true
        }
      }
    },
    "delegationRevocationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegationRecordDigest", "reason"],
      "properties": {
        "delegationRecordDigest": {
          "$ref": "#/$defs/digest"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migrationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governanceSelectionRecordDigest",
        "delegationGrantRecordDigest",
        "toolingAuthorizationRecordDigest",
        "materialDecisionIds",
        "decisionCounts",
        "evidenceRequirements",
        "runtimeEvidence",
        "nativeMatrix",
        "materialDecisionApprover",
        "responsibleAfterApproval"
      ],
      "properties": {
        "governanceSelectionRecordDigest": {
          "$ref": "#/$defs/digest"
        },
        "delegationGrantRecordDigest": {
          "$ref": "#/$defs/digest"
        },
        "toolingAuthorizationRecordDigest": {
          "$ref": "#/$defs/digest"
        },
        "materialDecisionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decisionCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposed", "blocked", "accepted"],
          "properties": {
            "proposed": {
              "type": "integer",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "minimum": 0
            },
            "accepted": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidenceRequirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "unsatisfied"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "unsatisfied": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "runtimeEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conducted", "passed", "failed", "unattempted"],
          "properties": {
            "conducted": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "unattempted": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "nativeMatrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "unattempted"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "unattempted": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "materialDecisionApprover": {
          "const": "Marlon"
        },
        "responsibleAfterApproval": {
          "const": "Adriana"
        }
      }
    },
    "reviewPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "outcome", "subjectBundleSha256", "reviewedHead"],
      "properties": {
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": ["PASS", "FAIL"]
        },
        "subjectBundleSha256": {
          "$ref": "#/$defs/digest"
        },
        "reviewedHead": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "decisionApprovalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "approvedValue", "evidenceByRequirement"],
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "approvedValue": {
          "type": "string",
          "minLength": 1
        },
        "evidenceByRequirement": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "decisionSupersessionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "supersedesRecordDigest",
        "approvedValue",
        "evidenceByRequirement"
      ],
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "supersedesRecordDigest": {
          "$ref": "#/$defs/digest"
        },
        "approvedValue": {
          "type": "string",
          "minLength": 1
        },
        "evidenceByRequirement": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "phaseApprovalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phaseId", "scope", "gateRecordDigests", "subjectBundleSha256"],
      "properties": {
        "phaseId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "credential_free_repository_only_nonproduction_phase_after_required_gates"
        },
        "gateRecordDigests": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "subjectBundleSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "toolingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "classification",
        "runtimeOrProductAuthorization",
        "nativeEvidenceSatisfaction",
        "externalActionAuthorization",
        "baseFiles",
        "targetFiles",
        "baseBundleSha256",
        "targetBundleSha256",
        "atomicSemantics"
      ],
      "properties": {
        "decision": {
          "const": "DEPENDENCY_LOCK_REMEDIATION_OPTION_A"
        },
        "classification": {
          "const": "credential_free_dev_tool_only"
        },
        "runtimeOrProductAuthorization": {
          "const": false
        },
        "nativeEvidenceSatisfaction": {
          "const": false
        },
        "externalActionAuthorization": {
          "const": false
        },
        "baseFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "targetFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "baseBundleSha256": {
          "$ref": "#/$defs/digest"
        },
        "targetBundleSha256": {
          "$ref": "#/$defs/digest"
        },
        "atomicSemantics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifestChanges", "lockfileChanges", "forbiddenChanges"],
          "properties": {
            "manifestChanges": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "lockfileChanges": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbiddenChanges": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
