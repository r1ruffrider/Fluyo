{
  "schema": "fluyo:r4b:windows-native-contract:v3",
  "protocolVersion": 3,
  "transport": {
    "kind": "inherited-anonymous-pipes",
    "requestPipe": "broker-stdin",
    "responsePipe": "broker-stdout",
