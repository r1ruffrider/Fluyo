    "maximumFrameBytes": 67174400,
    "authoritativeFilesystemMessages": false,
    "persistentBrokerPerCommand": true
  },
  "transaction": {
    "states": ["INTENT_DURABLE", "APPLIED_UNACKED_DURABLE", "ACKED_COMMITTED_DURABLE"],
    "ack": "sha256(response-frame)-over-request-pipe",
    "finalCommitConfirmation": "COMMIT_CONFIRMED-bound-to-post-ack-journal-sequence-and-digest",
    "replay": "same-session-sequence-request-digest-returns-identical-response-without-reapply",
    "controllerLoss": "JOURNAL_PERMANENT_HELD",
    "orphanedJournal": "ORPHANED_PERMANENT_HELD",
    "permanentHeldRecovery": "forbidden-with-zero-mutation-retry-or-cleanup",
    "recoveryOperation": "RECOVER_SESSION",
    "recoveryOutcomes": [
      "VERIFIED_APPLIED_UNACKED",
      "VERIFIED_NOT_APPLIED",
      "VERIFIED_COMMITTED",
      "AMBIGUOUS_PERMANENT_HELD",
      "JOURNAL_PERMANENT_HELD"
    ],
    "recoveryBinding": "caller-supplies-failure-event+request-id+controller-creation-identity+journal-anchor;broker-derives-outcome-from-journal+retained-handle-or-filesystem-identity",
    "journalFormat": "J2|state|requestSequence|sessionNonce|operation|requestSha256|rootId|relativePathBase64|relativePath2Base64|beforeIdentity|afterIdentity|responseSha256|responseByteLength|responseBase64|previousRecordSha256|recordSha256",
    "journalRecordSha256": "sha256-utf8-pipe-join-fields-0-through-14",
    "preResponseAnchor": "durable-predecessor-only-never-predicted-post-ack",
    "legacyJournal": "nonempty-non-J2-permanent-held-with-zero-action",
    "jobCloseDurability": "canonical-JOB_CLOSED-receipt-is-hash-chained-before-job-release",
    "renameRecovery": "source-absence+exact-destination-volume-file-id-content-digest",
    "cleanupTombstone": "internally-issued-original-lease-bound-no-op-only",
    "nvdaControlFlow": "one-control+one-ready-ack-before-each-observation"
  },
